SECRET_KEY=django-insecure-dev-key-change-in-prod
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

DB_NAME=pos_restro_hotel
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5434

REDIS_URL=redis://localhost:6379/0
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Optional — enables Postgres row-level security enforcement (defense in
# depth behind the app-level tenant scoping). Leave unset for local dev;
# see docs/rls.md. When set, `manage.py setup_rls` (run automatically by
# entrypoint.sh) provisions this role and the server connects as it
# instead of DB_USER above.
# RUNTIME_DB_USER=app_runtime
# RLS_RUNTIME_DB_PASSWORD=
